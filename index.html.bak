    <!-- ════ APPLICATIONS ════ -->
    <div class="page" id="page-applications">
      <div class="toolbar" style="margin-bottom:18px;">
        <div class="search-box">
          <svg viewBox="0 0 24 24" fill="none"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          <input type="text" placeholder="Search applicants…"/>
        </div>
        <span class="badge yellow" style="padding:7px 14px;font-size:.78rem;">5 Pending Review</span>
      </div>

      <div class="app-card">
        <div class="app-card-head">
          <div class="app-big-avatar">CR</div>
          <div style="flex:1">
            <div class="app-name">Carlos Reyes</div>
            <div class="app-meta">Applied: March 8, 2026 &nbsp;•&nbsp; 09-5678-1234</div>
          </div>
          <span class="badge yellow"><span class="badge-dot"></span>Pending</span>
        </div>
        <div class="app-card-body">
          <div class="app-field"><div class="app-field-lbl">License No.</div><div class="app-field-val">N03-12-345678</div></div>
