    <!-- ════ MESSAGES ════ -->
    <div class="page" id="page-messages">
      <div class="msg-layout">
        <div class="msg-list">
          <div class="msg-search"><input type="text" placeholder="Search messages…"/></div>
          <div class="msg-item active" onclick="selectMsg(this,'Ana Lim','Complaint about driver','Hello, I would like to report that the driver was very rude during my trip earlier today. He refused to follow my preferred route and was quite aggressive.','10:32 AM')">
            <div class="msg-item-head"><span class="msg-sender">Ana Lim</span><span class="msg-time">10:32 AM</span></div>
            <div style="display:flex;align-items:center;gap:6px"><div class="msg-preview">Complaint about driver behavior…</div><div class="msg-unread"></div></div>
          </div>
          <div class="msg-item" onclick="selectMsg(this,'Roberto Tan','Booking issue','I tried to book a ride at around 8pm last night but the app kept showing no available drivers. Is there a problem with the system?','9:15 AM')">
            <div class="msg-item-head"><span class="msg-sender">Roberto Tan</span><span class="msg-time">9:15 AM</span></div>
            <div style="display:flex;align-items:center;gap:6px"><div class="msg-preview">Booking issue — no drivers available</div><div class="msg-unread"></div></div>
          </div>
          <div class="msg-item" onclick="selectMsg(this,'Maria Garcia','Fare inquiry','Good day! I just want to ask about the current fare rates. The app showed a different amount from what the driver charged me.','Yesterday')">
            <div class="msg-item-head"><span class="msg-sender">Maria Garcia</span><span class="msg-time">Yesterday</span></div>
            <div class="msg-preview">Fare inquiry — discrepancy in amount</div>
          </div>
          <div class="msg-item" onclick="selectMsg(this,'John Bautista','Lost item','Hi! I left my umbrella in the tricycle earlier. Can you help me contact the driver?','Yesterday')">
            <div class="msg-item-head"><span class="msg-sender">John Bautista</span><span class="msg-time">Yesterday</span></div>
            <div class="msg-preview">Lost item — left umbrella in tricycle</div>
          </div>
          <div class="msg-item" onclick="selectMsg(this,'Lisa Santos','General feedback','Just wanted to say that the FINDER app is really convenient! Much better than waiting at the terminal.','Mar 6')">
            <div class="msg-item-head"><span class="msg-sender">Lisa Santos</span><span class="msg-time">Mar 6</span></div>
            <div class="msg-preview">Great experience using the app!</div>
          </div>
        </div>
        <div class="msg-detail">
          <div class="msg-detail-head">
            <div>
              <div class="msg-detail-name" id="msg-sender-name">Ana Lim</div>
              <div class="msg-detail-sub" id="msg-subject">Complaint about driver</div>
            </div>
            <div style="display:flex;gap:8px">
              <button class="btn btn-ghost btn-sm">Mark Resolved</button>
              <span class="badge red">Unresolved</span>
            </div>
          </div>
          <div class="msg-body" id="msg-body">
            <div>
              <div class="bubble in" id="msg-content">Hello, I would like to report that the driver was very rude during my trip earlier today. He refused to follow my preferred route and was quite aggressive.</div>
              <div class="bubble-time">10:32 AM</div>
            </div>
          </div>
          <div class="msg-input-bar">
            <input class="msg-input" type="text" placeholder="Type a reply…" id="msg-reply-input"/>
            <button class="btn btn-primary btn-sm" onclick="sendReply()">Send</button>
          </div>
        </div>
      </div>
    </div>

    <!-- ════ REPORTS ════ -->
