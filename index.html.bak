<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>FINDER — Admin Panel</title>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&family=Syne:wght@600;700;800&display=swap" rel="stylesheet"/>
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.0/chart.umd.min.js"></script>
  <link rel="stylesheet" href="finder-admin.css">
</head>
<body class="logged-out">

<!-- ════ LOGIN PAGE ════ -->
<div class="login-screen">
  <div class="login-blobs">
    <div class="blob blob-1"></div>
    <div class="blob blob-2"></div>
    <div class="blob blob-3"></div>
  </div>
  
  <div class="login-card">
    <div class="logo-text" style="font-size: 2.2rem; margin-bottom: 40px; display: block; text-align: center;">FIND<span>ER</span></div>
    
    <div class="login-welcome">
      <h1>Welcome back</h1>
      <p>Sign in to continue your journey</p>
    </div>

    <form class="login-form" onsubmit="handleLogin(event)">
      <div class="login-field">
        <label class="login-label">Email</label>
        <div class="login-input-wrap">
          <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
          <input type="email" class="login-input" placeholder="you@example.com" value="admin@finder-toda.ph" required/>
        </div>
      </div>

      <div class="login-field">
        <label class="login-label">Password</label>
        <div class="login-input-wrap">
          <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>
          <input type="password" class="login-input" placeholder="Enter your password" value="••••••••" required/>
        </div>
      </div>

      <div class="login-options">
        <label class="remember-me">
          <input type="checkbox" checked/>
          Remember Me
        </label>
        <a href="#" class="forgot-pass" onclick="openResetModal()">Forgot password?</a>
      </div>

      <button type="submit" class="btn btn-primary btn-login">Sign In</button>
    </form>
  </div>
</div>

<!-- ════ RESET PASSWORD MODAL ════ -->
<div class="modal-overlay" id="reset-modal">
  <div class="modal-box reset-modal">
    <button class="modal-close" onclick="closeResetModal()" style="position: absolute; top: 16px; right: 16px;"><svg viewBox="0 0 24 24" fill="none"><path d="M18 6L6 18M6 6l12 12" stroke-width="2.5" stroke-linecap="round"/></svg></button>
    
    <div class="reset-icon-wrap">
      <svg viewBox="0 0 24 24" fill="none" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3L15.5 7.5z"/></svg>
    </div>
    
    <h2 class="reset-title">Reset password</h2>
    <p class="reset-desc">No worries! Enter your email address and we'll send you a link to reset your password.</p>
    
    <div class="login-field" style="margin-bottom: 24px;">
      <div class="login-input-wrap">
        <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
        <input type="email" class="login-input" placeholder="you@example.com"/>
      </div>
    </div>
    
    <button class="btn btn-primary" style="width: 100%; padding: 14px; font-weight: 700;" onclick="closeResetModal()">Send Reset Link</button>
  </div>
</div>
<div class="app">

<!-- ══ SIDEBAR ══ -->
<aside class="sidebar">
  <div class="sidebar-logo">
    <div class="logo-icon">
      <svg viewBox="0 0 24 24"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
    </div>
    <span class="logo-text">FIND<span>ER</span></span>
  </div>

  <div class="sidebar-section">Main</div>
  <a class="nav-item active" onclick="goto('dashboard',this)">
    <svg viewBox="0 0 24 24" fill="none"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
    Dashboard
  </a>
  <a class="nav-item" onclick="goto('analytics',this)">
    <svg viewBox="0 0 24 24" fill="none"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
    Analytics
  </a>

  <div class="sidebar-section">Management</div>
  <a class="nav-item" onclick="goto('drivers',this)">
    <svg viewBox="0 0 24 24" fill="none"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"/></svg>
    Users (Drivers)
  </a>
  <a class="nav-item" onclick="goto('applications',this)">
    <svg viewBox="0 0 24 24" fill="none"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
    Driver Applications
    <span class="nav-badge">5</span>
  </a>
  <a class="nav-item" onclick="goto('messages',this)">
    <svg viewBox="0 0 24 24" fill="none"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/></svg>
    Passenger Messages
    <span class="nav-badge">3</span>
  </a>

  <div class="sidebar-section">Operations</div>
  <a class="nav-item" onclick="goto('reports',this)">
    <svg viewBox="0 0 24 24" fill="none"><path d="M13 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V9z"/><polyline points="13 2 13 9 20 9"/></svg>
    Reports
  </a>
  <a class="nav-item" onclick="goto('fare',this)">
    <svg viewBox="0 0 24 24" fill="none"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"/></svg>
    Fare Management
  </a>
  <a class="nav-item" onclick="goto('audit',this)">
    <svg viewBox="0 0 24 24" fill="none"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
    Audit Log
  </a>

  <div class="sidebar-section">System</div>
  <a class="nav-item" onclick="goto('settings',this)">
    <svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 010 2.83 2 2 0 01-2.83 0l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-4 0v-.09A1.65 1.65 0 009 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 01-2.83-2.83l.06-.06A1.65 1.65 0 004.68 15a1.65 1.65 0 00-1.51-1H3a2 2 0 010-4h.09A1.65 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 012.83-2.83l.06.06A1.65 1.65 0 009 4.68a1.65 1.65 0 001-1.51V3a2 2 0 014 0v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 012.83 2.83l-.06.06A1.65 1.65 0 0019.4 9a1.65 1.65 0 001.51 1H21a2 2 0 010 4h-.09a1.65 1.65 0 00-1.51 1z"/></svg>
    Settings
  </a>
  <div class="logout-btn" onclick="handleLogout()">
    <svg viewBox="0 0 24 24" fill="none" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4M16 17l5-5-5-5M21 12H9"/></svg>
    Log Out
  </div>

  <div class="sidebar-bottom">
    <div class="admin-pill">
      <div class="admin-avatar">JD</div>
      <div class="admin-info">
        <div class="admin-name">Juan Dela Cruz</div>
        <div class="admin-role">System Administrator</div>
      </div>
    </div>
  </div>
</aside>

<!-- ══ MAIN ══ -->
<div class="main">
  <div class="topbar">
    <div>
      <span class="topbar-title" id="topbar-title">Dashboard</span>
      <span class="topbar-sub" id="topbar-sub">— Overview</span>
    </div>
    <div class="topbar-right">
      <div class="date-badge" id="today-date"></div>
      <button class="topbar-btn" title="Search"><svg viewBox="0 0 24 24" fill="none"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg></button>
      <button class="topbar-btn" title="Notifications"><svg viewBox="0 0 24 24" fill="none"><path d="M18 8A6 6 0 006 8c0 7-3 9-3 9h18s-3-2-3-9M13.73 21a2 2 0 01-3.46 0"/></svg><span class="notif-dot"></span></button>
    </div>
  </div>

  <div class="content">

    <!-- ════ DASHBOARD ════ -->
    <div class="page active" id="page-dashboard">
      <div class="stat-grid">
        <div class="stat-card">
          <div class="stat-label">Registered Drivers</div>
          <div class="stat-val">48</div>
          <div class="stat-trend up">↑ 3 this week</div>
          <div class="stat-icon"><svg viewBox="0 0 24 24" fill="none"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg></div>
        </div>
        <div class="stat-card">
          <div class="stat-label">Pending Application</div>
          <div class="stat-val">5</div>
          <div class="stat-trend neutral">Awaiting review</div>
          <div class="stat-icon"><svg viewBox="0 0 24 24" fill="none"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/></svg></div>
        </div>
        <div class="stat-card">
          <div class="stat-label">Completed Trips</div>
          <div class="stat-val green">112</div>
          <div class="stat-trend up">88% completion rate</div>
          <div class="stat-icon"><svg viewBox="0 0 24 24" fill="none"><polyline points="20 6 9 17 4 12"/></svg></div>
        </div>
        <div class="stat-card">
          <div class="stat-label">Cancelled Trips</div>
          <div class="stat-val red">15</div>
          <div class="stat-trend down">↑ 2 from yesterday</div>
          <div class="stat-icon"><svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg></div>
        </div>
      </div>

      <div class="chart-section" style="margin-bottom: 32px;">
        <div class="sec-header">
          <span class="sec-title">Trip Activity (Last 7 Days)</span>
        </div>
        <div class="chart-card" style="height: 420px;">
          <canvas id="dashTripChart"></canvas>
        </div>
      </div>

      <div class="dash-bottom-grid">
        <div class="recent-activity-section">
          <div class="sec-header">
            <span class="sec-title">Recent Activity</span>
          </div>
          <div class="activity-list">
            <div class="activity-item">
              <div class="activity-dot brand"><svg viewBox="0 0 24 24" fill="none"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg></div>
              <div class="activity-text">
                <div class="activity-main">New driver application from Carlos Reyes</div>
                <div class="activity-time">5 minutes ago</div>
              </div>
            </div>
            <div class="activity-item">
              <div class="activity-dot green"><svg viewBox="0 0 24 24" fill="none"><polyline points="20 6 9 17 4 12"/></svg></div>
              <div class="activity-text">
                <div class="activity-main">Trip #1042 completed by Marco Santos</div>
                <div class="activity-time">12 minutes ago</div>
              </div>
            </div>
            <div class="activity-item">
              <div class="activity-dot red"><svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg></div>
              <div class="activity-text">
                <div class="activity-main">Trip #1041 cancelled by passenger</div>
                <div class="activity-time">18 minutes ago</div>
              </div>
            </div>
            <div class="activity-item">
              <div class="activity-dot blue"><svg viewBox="0 0 24 24" fill="none"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/></svg></div>
              <div class="activity-text">
                <div class="activity-main">Message from passenger Ana Lim</div>
                <div class="activity-time">34 minutes ago</div>
              </div>
            </div>
            <div class="activity-item">
              <div class="activity-dot brand"><svg viewBox="0 0 24 24" fill="none"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg></div>
              <div class="activity-text">
                <div class="activity-main">Driver Jose Rivera approved by admin</div>
                <div class="activity-time">1 hour ago</div>
              </div>
            </div>
            <div class="activity-item">
              <div class="activity-dot green"><svg viewBox="0 0 24 24" fill="none"><polyline points="20 6 9 17 4 12"/></svg></div>
              <div class="activity-text">
                <div class="activity-main">Trip #1039 completed by Pedro Cruz</div>
                <div class="activity-time">1 hour ago</div>
              </div>
            </div>
          </div>
        </div>

        <div class="activity-overview-section">
          <div class="sec-header">
            <span class="sec-title">Activity Overview</span>
          </div>
          <div class="overview-card">
            <div class="stat-label">TOTAL TRIPS TODAY</div>
            <div class="stat-val">127</div>
            <div class="stat-trend"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg> 12% vs yesterday</div>
            <div class="overview-icon-bg"></div>
          </div>
          <div class="overview-card">
            <div class="stat-label">PASSENGER REQUEST</div>
            <div class="stat-val">134</div>
            <div class="stat-trend"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg> 8 new today</div>
            <div class="overview-icon-bg"></div>
          </div>
        </div>
      </div>
    </div>

    <!-- ════ ANALYTICS ════ -->
    <div class="page" id="page-analytics">
      <div class="stat-grid" style="margin-bottom:28px;">
        <div class="stat-card">
          <div class="stat-label">THIS WEEKS TRIPS</div>
          <div class="stat-val">847</div>
          <div class="stat-trend up">↑ 14% vs last week</div>
          <div class="overview-icon-bg"></div>
        </div>
        <div class="stat-card">
          <div class="stat-label">COMPLETION RATE</div>
          <div class="stat-val green">88%</div>
          <div class="stat-trend up">↑ 2% improvement</div>
          <div class="overview-icon-bg"></div>
        </div>
        <div class="stat-card">
          <div class="stat-label">AVG DAILY TRIP</div>
          <div class="stat-val">121</div>
          <div class="stat-trend up">↑ 5 from last week</div>
          <div class="overview-icon-bg"></div>
        </div>
        <div class="stat-card">
          <div class="stat-label">PEAK HOUR</div>
          <div class="stat-val">7-8 am</div>
          <div class="stat-trend neutral">Most active window</div>
          <div class="overview-icon-bg"></div>
        </div>
      </div>

      <div class="chart-section" style="margin-bottom: 28px;">
        <div class="chart-card">
          <div class="sec-header">
            <span class="sec-title">Daily Trip</span>
            <select class="filter-select"><option>February</option><option>January</option></select>
          </div>
          <div style="height: 340px;">
            <canvas id="analyticsTrendChart"></canvas>
          </div>
        </div>
      </div>

      <div class="chart-section" style="margin-bottom: 28px;">
        <div class="chart-card">
          <div class="sec-header">
            <span class="sec-title">Peak Booking Hours</span>
          </div>
          <div style="height: 320px;">
            <canvas id="peakHoursChart"></canvas>
          </div>
        </div>
      </div>

      <div class="dash-bottom-grid" style="grid-template-columns: 1fr 1.2fr; gap: 28px;">
        <div class="chart-card">
          <div class="sec-header">
            <span class="sec-title">Completed vs Cancelled</span>
            <select class="filter-select"><option>February</option></select>
          </div>
          <div style="display: flex; align-items: center; gap: 20px; height: 300px; position: relative;">
            <div style="width: 140px; display: flex; flex-direction: column; gap: 60px;">
              <div style="display:flex; align-items:center; gap:12px;">
                <div style="width:40px; height:12px; background:var(--brand); border-radius:4px;"></div>
                <span style="font-size:0.85rem; font-weight:600; color:var(--muted);">Completed</span>
              </div>
              <div style="display:flex; align-items:center; gap:12px;">
                <div style="width:40px; height:12px; background:#fca5a5; border-radius:4px;"></div>
                <span style="font-size:0.85rem; font-weight:600; color:var(--muted);">Cancelled</span>
              </div>
            </div>
            <div style="flex: 1; height: 100%; position: relative;">
              <canvas id="analyticsDonut"></canvas>
            </div>
          </div>
        </div>

        <div class="chart-card">
          <div class="sec-header">
            <span class="sec-title">Most Active Drivers</span>
            <select class="filter-select"><option>February</option></select>
          </div>
          <div class="table-wrap" style="border:none;">
            <table style="font-size: 0.82rem;">
              <thead style="background:var(--brand-ll);">
                <tr><th>DRIVER</th><th style="text-align:center;">TRIPS</th><th style="text-align:center;">RATE</th><th style="text-align:center;">STATUS</th></tr>
              </thead>
              <tbody>
                <tr><td>Marco Santos</td><td style="text-align:center; font-weight:700;">48</td><td style="text-align:center; font-weight:600;">96%</td><td style="text-align:center;"><span class="badge green" style="background:none; border: 1.2px solid var(--green-l); color:#16a34a; padding: 2px 10px;"><span class="badge-dot"></span> online</span></td></tr>
                <tr><td>Pedro Dela Cruz</td><td style="text-align:center; font-weight:700;">43</td><td style="text-align:center; font-weight:600;">91%</td><td style="text-align:center;"><span class="badge green" style="background:none; border: 1.2px solid var(--green-l); color:#16a34a; padding: 2px 10px;"><span class="badge-dot"></span> online</span></td></tr>
                <tr><td>Jose Rivera</td><td style="text-align:center; font-weight:700;">37</td><td style="text-align:center; font-weight:600;">89%</td><td style="text-align:center;"><span class="badge green" style="background:none; border: 1.2px solid var(--green-l); color:#16a34a; padding: 2px 10px;"><span class="badge-dot"></span> online</span></td></tr>
                <tr><td>Marcelino Zafra</td><td style="text-align:center; font-weight:700;">34</td><td style="text-align:center; font-weight:600;">94%</td><td style="text-align:center;"><span class="badge green" style="background:none; border: 1.2px solid var(--green-l); color:#16a34a; padding: 2px 10px;"><span class="badge-dot"></span> online</span></td></tr>
                <tr><td>Michael Reyes</td><td style="text-align:center; font-weight:700;">29</td><td style="text-align:center; font-weight:600;">97%</td><td style="text-align:center;"><span class="badge red" style="background:none; border: 1.2px solid var(--red-l); color:var(--brand); padding: 2px 10px;"><span class="badge-dot"></span> offline</span></td></tr>
                <tr><td>Luis Gomez</td><td style="text-align:center; font-weight:700;">23</td><td style="text-align:center; font-weight:600;">87%</td><td style="text-align:center;"><span class="badge green" style="background:none; border: 1.2px solid var(--green-l); color:#16a34a; padding: 2px 10px;"><span class="badge-dot"></span> online</span></td></tr>
                <tr><td>Ramon Flores</td><td style="text-align:center; font-weight:700;">19</td><td style="text-align:center; font-weight:600;">93%</td><td style="text-align:center;"><span class="badge yellow" style="background:none; border: 1.2px solid var(--yellow-l); color:#d97706; padding: 2px 10px;"><span class="badge-dot"></span> inactive</span></td></tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>

    <!-- ════ DRIVERS ════ -->
    <div class="page" id="page-drivers">
      <div class="toolbar">
        <div class="search-box">
          <svg viewBox="0 0 24 24" fill="none"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          <input type="text" placeholder="Search drivers…"/>
        </div>
        <select class="filter-select"><option>All Status</option><option>Online</option><option>Offline</option><option>Inactive</option></select>
        <select class="filter-select"><option>Sort by: Name</option><option>Sort by: Trips</option><option>Sort by: Date</option></select>
      </div>

      <div class="driver-grid">
        <!-- Driver cards -->
        <div class="driver-card" onclick="openDriverModal('Marco Santos','DR-0012','Online','48','96%','Toyota Tricycle • ABC-1234','09171234567')">
          <div class="driver-head">
            <div class="driver-avatar">MS</div>
            <div><div class="driver-name">Marco Santos</div><div class="driver-id">DR-0012</div></div>
            <div style="margin-left:auto"><span class="badge green"><span class="badge-dot"></span>Online</span></div>
          </div>
          <div class="driver-stats">
            <div class="driver-stat"><div class="driver-stat-val">48</div><div class="driver-stat-lbl">Trips</div></div>
