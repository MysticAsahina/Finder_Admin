          <div class="app-field"><div class="app-field-lbl">Plate Number</div><div class="app-field-val">ABD-5566</div></div>
          <div class="app-field"><div class="app-field-lbl">Vehicle Color</div><div class="app-field-val">Blue / Silver</div></div>
        </div>
        <div style="display:flex;gap:10px;margin-bottom:14px;">
          <div style="flex:1;background:var(--bg2);border-radius:10px;height:90px;display:flex;align-items:center;justify-content:center;gap:8px;color:var(--muted);font-size:.8rem;cursor:pointer;" onclick="alert('Driver License Photo')">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="1" y="5" width="22" height="14" rx="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
            Driver's License
          </div>
          <div style="flex:1;background:var(--bg2);border-radius:10px;height:90px;display:flex;align-items:center;justify-content:center;gap:8px;color:var(--muted);font-size:.8rem;cursor:pointer;" onclick="alert('Vehicle Photo')">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
