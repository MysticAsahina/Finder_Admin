            <tr><td style="padding: 16px;">#1028</td><td style="padding: 16px;">Mar 4, 2026</td><td style="padding: 16px;">Ramon Flores</td><td style="padding: 16px;">Nestor Reyes</td><td style="padding: 16px;">4.0 km</td><td style="padding: 16px;">₱68.00</td><td style="padding: 16px;"><span class="badge green" style="background: var(--green-l); color: var(--green); border: none;">Completed</span></td></tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- ════ FARE MANAGEMENT ════ -->
    <div class="page" id="page-fare">
      <div class="fare-grid">
        <div class="fare-card">
          <div class="fare-card-title">Base Fare</div>
          <div class="fare-card-sub">Minimum charge for any ride regardless of distance</div>
          <div class="fare-input-wrap">
            <span class="fare-prefix">₱</span>
            <input class="fare-input" type="number" value="25.00" step="0.50"/>
          </div>
          <div class="fare-note">Current: ₱25.00 — Last updated Mar 1, 2026</div>
        </div>
        <div class="fare-card">
          <div class="fare-card-title">Additional Fare per Kilometer</div>
          <div class="fare-card-sub">Extra charge added per km beyond base distance</div>
          <div class="fare-input-wrap">
            <span class="fare-prefix">₱</span>
            <input class="fare-input" type="number" value="8.50" step="0.50"/>
          </div>
          <div class="fare-note">Current: ₱8.50/km — Last updated Mar 1, 2026</div>
        </div>
      </div>

      <div class="ordinance-card">
        <div style="font-weight:700;font-size:.92rem;margin-bottom:4px;">City Ordinance Reference</div>
        <div style="font-size:.78rem;color:var(--muted);margin-bottom:14px;">Fare rates must comply with local transportation regulations</div>
        <div class="ordinance-img">
          <div style="text-align:center">
            <svg viewBox="0 0 24 24" fill="none" width="36" height="36" stroke="var(--subtle)" stroke-width="1.5"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
            <div style="font-size:.78rem;color:var(--subtle);margin-top:8px;">Ordinance Document Preview</div>
            <div style="font-size:.72rem;color:var(--border);margin-top:2px;">City Ordinance No. 2024-012</div>
          </div>
        </div>
        <div style="display:flex;gap:10px;">
          <button class="btn btn-ghost btn-sm" style="display:flex;align-items:center;gap:6px">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            View Document
          </button>
          <button class="btn btn-ghost btn-sm">Upload New</button>
        </div>
      </div>

      <div style="display:flex;gap:10px;justify-content:flex-end;padding-top:4px;">
        <button class="btn btn-outline">Discard Changes</button>
        <button class="btn btn-primary">Save Fare Settings</button>
      </div>
    </div>

    <!-- ════ AUDIT LOG ════ -->
    <div class="page" id="page-audit">
      <div class="toolbar" style="margin-bottom:18px;">
        <div class="search-box">
          <svg viewBox="0 0 24 24" fill="none"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          <input type="text" placeholder="Search logs…"/>
        </div>
        <select class="filter-select"><option>All Actions</option><option>Login/Logout</option><option>Driver Approvals</option><option>Fare Changes</option><option>Config Changes</option></select>
        <select class="filter-select"><option>Today</option><option>This Week</option><option>This Month</option></select>
      </div>

      <div class="audit-item">
        <div class="audit-icon" style="background:var(--green-l);color:var(--green)"><svg viewBox="0 0 24 24" fill="none"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/></svg></div>
        <div class="audit-info">
          <div class="audit-action">Driver Application Approved</div>
          <div class="audit-detail">Admin <strong>Juan Dela Cruz</strong> approved application from <strong>Jose Rivera</strong> (DR-0007)</div>
        </div>
        <div class="audit-time">Mar 8, 2026<br>10:45 AM</div>
      </div>
      <div class="audit-item">
        <div class="audit-icon" style="background:var(--brand-l);color:var(--brand)"><svg viewBox="0 0 24 24" fill="none"><path d="M15 3h4a2 2 0 012 2v14a2 2 0 01-2 2h-4M10 17l5-5-5-5M15 12H3"/></svg></div>
        <div class="audit-info">
          <div class="audit-action">Admin Login</div>
          <div class="audit-detail"><strong>Juan Dela Cruz</strong> logged in from 192.168.1.104</div>
        </div>
        <div class="audit-time">Mar 8, 2026<br>8:02 AM</div>
      </div>
      <div class="audit-item">
        <div class="audit-icon" style="background:var(--yellow-l);color:var(--yellow)"><svg viewBox="0 0 24 24" fill="none"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"/></svg></div>
        <div class="audit-info">
          <div class="audit-action">Fare Settings Updated</div>
          <div class="audit-detail">Base fare changed from <strong>₱22.00</strong> to <strong>₱25.00</strong> by <strong>Juan Dela Cruz</strong></div>
        </div>
        <div class="audit-time">Mar 1, 2026<br>2:30 PM</div>
      </div>
      <div class="audit-item">
        <div class="audit-icon" style="background:var(--red-l);color:var(--red)"><svg viewBox="0 0 24 24" fill="none"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/></svg></div>
        <div class="audit-info">
          <div class="audit-action">Driver Application Rejected</div>
          <div class="audit-detail">Admin <strong>Juan Dela Cruz</strong> rejected application from <strong>Mark Villanueva</strong> — Incomplete license details</div>
        </div>
        <div class="audit-time">Feb 28, 2026<br>11:14 AM</div>
      </div>
      <div class="audit-item">
        <div class="audit-icon" style="background:var(--blue-l);color:var(--blue)"><svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 010 2.83 2 2 0 01-2.83 0l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-4 0v-.09A1.65 1.65 0 009 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 01-2.83-2.83l.06-.06A1.65 1.65 0 004.68 15a1.65 1.65 0 00-1.51-1H3a2 2 0 010-4h.09A1.65 1.65 0 004.6 9"/></svg></div>
        <div class="audit-info">
          <div class="audit-action">System Configuration Changed</div>
          <div class="audit-detail">Notification settings updated — driver push alerts enabled</div>
        </div>
        <div class="audit-time">Feb 27, 2026<br>9:58 AM</div>
      </div>
      <div class="audit-item">
        <div class="audit-icon" style="background:var(--brand-l);color:var(--brand)"><svg viewBox="0 0 24 24" fill="none"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4M16 17l5-5-5-5M21 12H9"/></svg></div>
        <div class="audit-info">
          <div class="audit-action">Admin Logout</div>
          <div class="audit-detail"><strong>Juan Dela Cruz</strong> logged out</div>
        </div>
        <div class="audit-time">Feb 26, 2026<br>6:01 PM</div>
      </div>
    </div>

    <!-- ════ SETTINGS ════ -->
    <div class="page" id="page-settings">
      <div class="settings-card">
        <div class="settings-title">Admin Account</div>
        <div style="display:flex;align-items:center;gap:18px;margin-bottom:24px;padding:24px;background:var(--brand-ll);border-radius:14px;">
          <div style="width:64px;height:64px;background:var(--brand);border-radius:12px;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:1.5rem;color:white;">JD</div>
          <div>
            <div style="font-weight:700;font-size:1.1rem;color:var(--text);margin-bottom:2px;">Juan Dela Cruz</div>
            <div style="font-size:0.85rem;color:var(--muted);">admin@finder-toda.ph &nbsp;•&nbsp; System Administrator</div>
          </div>
        </div>
        
        <div class="form-row" style="margin-bottom: 20px;">
          <div class="form-field">
            <label class="form-label">FIRST NAME</label>
            <input class="form-input" value="Juan" style="background:var(--bg); border-color:var(--border-l);"/>
          </div>
          <div class="form-field">
            <label class="form-label">LAST NAME</label>
            <input class="form-input" value="Dela Cruz" style="background:var(--bg); border-color:var(--border-l);"/>
          </div>
        </div>
        <div class="form-row" style="margin-bottom: 24px;">
          <div class="form-field">
            <label class="form-label">EMAIL</label>
            <input class="form-input" value="admin@finder-toda.ph" style="background:var(--bg); border-color:var(--border-l);"/>
          </div>
          <div class="form-field">
            <label class="form-label">FIRST NAME</label>
            <input class="form-input" value="09171234567" style="background:var(--bg); border-color:var(--border-l);"/>
          </div>
        </div>
        <button class="btn btn-primary" style="padding: 10px 24px; border-radius: 10px;">Edit Profile</button>
      </div>

      <div class="settings-card">
        <div class="settings-title" style="display:flex; align-items:center; gap:10px;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--brand)" stroke-width="2.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          Security Configuration
        </div>
        <div class="toggle-row" style="padding: 12px 0;">
          <div class="toggle-info">
            <div class="toggle-name">Two-Factor Authentication</div>
            <div class="toggle-desc">Require MPIN on every admin login</div>
          </div>
          <label class="toggle"><input type="checkbox" checked/><span class="toggle-slider"></span></label>
        </div>
        <div class="toggle-row" style="padding: 12px 0; border-top: 1px solid var(--border-l); border-bottom: none;">
          <div class="toggle-info">
            <div class="toggle-name">Session Timeout</div>
            <div class="toggle-desc">Auto-logout after 30 minutes of inactivity</div>
          </div>
          <label class="toggle"><input type="checkbox"/><span class="toggle-slider"></span></label>
        </div>
      </div>

      <div class="settings-card">
        <div class="settings-title" style="display:flex; align-items:center; gap:10px;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--brand)" stroke-width="2.5"><path d="M18 8A6 6 0 006 8c0 7-3 9-3 9h18s-3-2-3-9M13.73 21a2 2 0 01-3.46 0"/></svg>
          Notification Settings
        </div>
        <div class="toggle-row" style="padding: 12px 0;">
          <div class="toggle-info">
            <div class="toggle-name">New Driver Applications</div>
            <div class="toggle-desc">Alert when a new driver submits an application</div>
          </div>
          <label class="toggle"><input type="checkbox" checked/><span class="toggle-slider"></span></label>
        </div>
        <div class="toggle-row" style="padding: 12px 0; border-top: 1px solid var(--border-l);">
          <div class="toggle-info">
            <div class="toggle-name">Passenger Messages</div>
            <div class="toggle-desc">Notify on new passenger inquiries or complaints</div>
          </div>
          <label class="toggle"><input type="checkbox" checked/><span class="toggle-slider"></span></label>
        </div>
        <div class="toggle-row" style="padding: 12px 0; border-top: 1px solid var(--border-l); border-bottom: none;">
          <div class="toggle-info">
            <div class="toggle-name">System Reports</div>
            <div class="toggle-desc">Weekly summary reports via email</div>
          </div>
          <label class="toggle"><input type="checkbox" checked/><span class="toggle-slider"></span></label>
        </div>
      </div>
    </div>

  </div><!-- /content -->
</div><!-- /main -->
</div><!-- /app -->

<!-- DRIVER MODAL -->
<div class="modal-overlay" id="driver-modal">
  <div class="modal-box" style="width: 520px; padding: 24px;">
    <div class="modal-head" style="margin-bottom: 20px;">
      <span class="modal-title" style="font-weight: 700;">Driver's Info</span>
      <button class="modal-close" onclick="closeDriverModal()"><svg viewBox="0 0 24 24" fill="none"><path d="M18 6L6 18M6 6l12 12" stroke-width="2.5" stroke-linecap="round"/></svg></button>
    </div>
    
    <!-- Profile Card -->
    <div style="display:flex;align-items:center;gap:18px;margin-bottom:20px;padding:24px;background:var(--bg);border-radius:18px;position:relative;">
      <div style="width:72px;height:72px;background:var(--brand);border-radius:16px;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:1.6rem;color:white;box-shadow: 0 4px 12px rgba(250,117,40,0.2);" id="modal-avatar">MS</div>
      <div>
        <div style="font-weight:700;font-size:1.1rem;color:var(--text);margin-bottom: 2px;" id="modal-name2">Marco Santos</div>
        <div style="font-size:0.85rem;color:var(--subtle);font-weight: 500;" id="modal-id">DR - 0012</div>
      </div>
      <div style="position: absolute; top: 24px; right: 24px;">
        <span class="badge green" style="padding: 4px 12px; font-size: 0.75rem;" id="modal-status">online</span>
      </div>
    </div>

    <!-- Stats Row -->
    <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px;margin-bottom:20px;">
      <div style="background:var(--bg); padding: 12px; border-radius: 12px; text-align: center;">
        <div style="font-weight:800;font-size:0.95rem;color:var(--text);" id="modal-trips">48</div>
        <div style="font-size:0.65rem;color:var(--subtle);text-transform:uppercase;letter-spacing:0.05em;font-weight: 700;margin-top: 2px;">Trips</div>
      </div>
      <div style="background:var(--bg); padding: 12px; border-radius: 12px; text-align: center;">
        <div style="font-weight:800;font-size:0.95rem;color:var(--text);" id="modal-rate">96%</div>
        <div style="font-size:0.65rem;color:var(--subtle);text-transform:uppercase;letter-spacing:0.05em;font-weight: 700;margin-top: 2px;">Rate</div>
      </div>
      <div style="background:var(--bg); padding: 12px; border-radius: 12px; text-align: center;">
        <div style="font-weight:800;font-size:0.95rem;color:var(--text);">4.9</div>
        <div style="font-size:0.65rem;color:var(--subtle);text-transform:uppercase;letter-spacing:0.05em;font-weight: 700;margin-top: 2px;">Rating</div>
      </div>
    </div>

    <!-- Info Row -->
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:20px;">
      <div class="app-field" style="background: var(--bg); padding: 16px; border-radius: 14px; border: none;">
        <div class="app-field-lbl" style="font-size: 0.78rem; margin-bottom: 6px; color: var(--subtle); font-weight: 600;">Vehicle</div>
        <div class="app-field-val" style="font-size: 0.95rem; color: var(--text); font-weight: 500;" id="modal-vehicle">Honda - TMX • ABC-1234</div>
      </div>
      <div class="app-field" style="background: var(--bg); padding: 16px; border-radius: 14px; border: none;">
        <div class="app-field-lbl" style="font-size: 0.78rem; margin-bottom: 6px; color: var(--subtle); font-weight: 600;">Contact</div>
        <div class="app-field-val" style="font-size: 0.95rem; color: var(--text); font-weight: 500;" id="modal-contact">09171234567</div>
      </div>
    </div>

    <!-- Docs Row -->
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom: 12px;">
      <div style="background: var(--bg); padding: 20px; border-radius: 14px; height: 110px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12px; cursor: pointer; border: 1.5px dashed var(--border-l);">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--muted)" stroke-width="2"><rect x="3" y="4" width="18" height="16" rx="2"/><line x1="3" y1="10" x2="21" y2="10"/><line x1="7" y1="15" x2="12" y2="15"/></svg>
        <span style="font-size: 0.85rem; font-weight: 600; color: var(--muted);">Driver's License</span>
      </div>
      <div style="background: var(--bg); padding: 20px; border-radius: 14px; height: 110px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12px; cursor: pointer; border: 1.5px dashed var(--border-l);">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--muted)" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
        <span style="font-size: 0.85rem; font-weight: 600; color: var(--muted);">Tricycle Photo</span>
      </div>
    </div>
  </div>
</div>

<script src="finder-admin.js"></script>
</body>
</html>
